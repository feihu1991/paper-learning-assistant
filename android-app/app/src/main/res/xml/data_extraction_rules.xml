<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 数据提取规则 (Android 12+) -->
    <data-extraction-rules>
        <cloud-backup>
            <include domain="sharedpref" path="."/>
            <exclude domain="sharedpref" path="device.xml"/>
        </cloud-backup>
    </data-extraction-rules>
    
    <!-- 备份规则 (Android 11 及以下) -->
    <full-backup-content>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
    </full-backup-content>
</resources>
